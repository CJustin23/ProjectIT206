# =============================================================================
# deploy/env.prod.example — MẪU file .env.prod đặt tại /opt/ffa trên VPS
#   cp deploy/env.prod.example .env.prod && chmod 600 .env.prod
# .env.prod KHÔNG commit (đã nằm trong .gitignore). Đổi TOÀN BỘ giá trị mẫu.
# Sinh mật khẩu/secret:  openssl rand -base64 32
# =============================================================================
COMPOSE_PROJECT_NAME=ffa-prod

# Domain đã trỏ A record về IP VPS — dùng cho certbot và CORS
FFA_DOMAIN=ffa.example.com
CORS_ALLOWED_ORIGINS=https://ffa.example.com

# MySQL
MYSQL_DATABASE=ffa_db
MYSQL_USER=ffa_user
MYSQL_PASSWORD=THAY-MAT-KHAU-NGAU-NHIEN
MYSQL_ROOT_PASSWORD=THAY-ROOT-NGAU-NHIEN

# JWT — secret >= 32 byte, bắt buộc khác với dev
JWT_SECRET=THAY-BANG-chuoi-48-byte-tu-openssl-rand-base64-48
JWT_ACCESS_TOKEN_MIN=15
JWT_REFRESH_TOKEN_DAY=30

# Image do workflow "release" đẩy lên GHCR; APP_VERSION = tag đang deploy
APP_IMAGE=ghcr.io/cjustin23/ffa-api:latest
WEB_IMAGE=ghcr.io/cjustin23/ffa-web:latest
APP_VERSION=latest
